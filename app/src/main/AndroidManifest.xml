<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:name=".CrystalOlympusApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${grayAppLabel}"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.CrystalOlympus"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Firebase: monochrome notification icon + default channel. Channel id
             is per-project and comes from gray.properties → BuildConfig →
             the manifest placeholder below. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notif_flame" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="${grayFcmChannelId}" />

        <!-- ══ LAUNCHER: gray/white router (shows the splash, decides the mode) ══ -->
        <activity
            android:name=".view.LaunchGate"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App.WindowGlue">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- No OneLink App Link filter on purpose. Attribution and deferred
                 deep links come off the wire, keyed by the AppsFlyer dev key and
                 the bundle id, so the shell stays free of any one OneLink host
                 and works with whatever template the account hands it. -->
        </activity>

        <activity
            android:name=".boot.OrbitShell"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.App.Stream" />

        <activity
            android:name=".boot.OptInPrompt"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App.WindowGlue" />

        <activity
            android:name=".boot.SignalLostScreen"
            android:exported="false"
            android:screenOrientation="sensor"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.App.WindowGlue" />

        <!-- ══ WHITE (native game) ══════════════════════════════════════════ -->
        <!-- Loading screen is the game's entry; goNative() routes here. It is no
             longer the launcher — LaunchGate decides who reaches it. -->
        <activity
            android:name=".LoadingActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.CrystalOlympus.Loading" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".WebViewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <service
            android:name=".prefs.FcmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
