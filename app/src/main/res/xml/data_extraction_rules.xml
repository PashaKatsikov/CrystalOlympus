<?xml version="1.0" encoding="utf-8"?>
<!--
  Neither Auto Backup nor Device-to-Device transfer may carry this app's data
  anywhere. An install arriving on a new handset has to reach its own routing
  decision there: a copied destination or push URL means an answer one server
  gave about one device showing up on somebody else's, and it also drags the
  same encrypted preferences file across every device the user owns.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
